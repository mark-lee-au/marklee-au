      "evidence": "rendering-hypothesis"
    },
    {
      "id": "radial-droop",
      "label": "Radial droop",
      "description": "Radial break with longer-lived particles/trails and stronger late downward curvature.",
      "baseCalibrationRef": "ams-peony-2017",
      "evidence": "rendering-hypothesis"
    },
    {
      "id": "sparse-arms",
      "label": "Sparse arms",
