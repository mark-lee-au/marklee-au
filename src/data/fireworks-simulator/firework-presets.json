    {
      "id": "nested",
      "label": "Nested layers",
      "description": "Coordinated inner and outer layers with separate scale and colour.",
      "baseCalibrationRef": null,
      "evidence": "rendering-hypothesis"
    },
    {
      "id": "phased-colour",
      "label": "Phased colour",
      "description": "Geometry remains coherent while colour transitions sweep spatially across the effect.",
