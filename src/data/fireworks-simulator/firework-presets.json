  "empiricalCalibrations": [
    {
      "id": "ams-peony-2017",
      "label": "Measured Peony example, Norman Oklahoma 2017 display",
      "familyId": "peony",
      "burstHeightM": 190,
      "maxDiameterM": 100,
      "visibleStarCount": 121,
      "visibleDurationS": 1.0,
      "initialExpansionMps": 170,
      "velocityModel": "v(t)=170/(1+0.04*170*t)",
      "radialDisplacementModel": "r(t)=ln(1+0.04*170*t)/0.04",
      "evidence": "measured",
      "sourceRefs": [
        "ams-fireworks-radar-2020"
      ],
      "limitations": "Single analysed Peony-like burst; not a universal shell profile."
    }
  ],
