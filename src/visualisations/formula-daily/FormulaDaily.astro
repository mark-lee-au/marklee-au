---
import './formula-daily.css';

const questionId = 'total-units-sold-east-v1';

const rows = [
  ['Region', 'Units', 'Rate', ''],
  ['East', '12', '4', ''],
  ['West', '8', '6', ''],
  ['East', '30', '5', ''],
  ['North', '16', '3', ''],
];

const pieces = [
  { id: 'countif', value: 'COUNTIF(', kind: 'function' },
  { id: 'countifs', value: 'COUNTIFS(', kind: 'function' },
  { id: 'b-range', value: 'B2:B5', kind: 'range' },
  { id: 'comma-1', value: ',', kind: 'syntax' },
  { id: 'east', value: '"East"', kind: 'value' },
  { id: 'sumif', value: 'SUMIF(', kind: 'function' },
  { id: 'sumifs', value: 'SUMIFS(', kind: 'function' },
  { id: 'close-1', value: ')', kind: 'syntax' },
  { id: 'a-range', value: 'A2:A5', kind: 'range' },
  { id: 'west', value: '"West"', kind: 'value' },
  { id: 'sum', value: 'SUM(', kind: 'function' },
  { id: 'comma-2', value: ',', kind: 'syntax' },
  { id: 'average', value: 'AVERAGE(', kind: 'function' },
  { id: 'equals', value: '=', kind: 'syntax' },
  { id: 'c-range', value: 'C2:C5', kind: 'range' },
  { id: 'open-1', value: '(', kind: 'syntax' },
  { id: 'north', value: '"North"', kind: 'value' },
  { id: 'count', value: 'COUNT(', kind: 'function' },
  { id: 'close-2', value: ')', kind: 'syntax' },
  { id: 'a2', value: 'A2', kind: 'range' },
  { id: 'comma-3', value: ',', kind: 'syntax' },
  { id: 'b2', value: 'B2', kind: 'range' },
  { id: 'open-2', value: '(', kind: 'syntax' },
  { id: 'close-3', value: ')', kind: 'syntax' },
  { id: 'multiply', value: '*', kind: 'syntax' },
  { id: 'twelve', value: '12', kind: 'value' },
];
---

<section class="formula-daily" data-formula-daily data-question-id={questionId} data-chalk="on" aria-labelledby="formula-question">
  <div
    class="formula-canvas"
    data-formula-canvas
    data-sample-open="true"
    role="group"
    aria-label="Formula construction chalkboard"
  >
    <div class="formula-canvas__notes" data-board-notes aria-hidden="true"></div>

    <header class="formula-canvas__heading">
      <h2 id="formula-question">Build the formula.</h2>
      <div class="formula-canvas__progress" aria-label="Question score, attempts, and display options">
        <p class="formula-canvas__points">Points <strong data-points-current>100</strong> / 100</p>
        <p>Attempt <strong data-attempt-count>0</strong> / 5</p>
        <label class="formula-canvas__chalk-toggle">
          <span>Chalk</span>
          <input type="checkbox" data-chalk-toggle role="switch" aria-label="Use chalk font" checked />
          <span class="formula-canvas__chalk-track" aria-hidden="true"></span>
        </label>
      </div>
    </header>

    <button
      class="formula-canvas__sample-toggle"
      type="button"
      data-sample-data-open
      aria-expanded="true"
      aria-controls="formula-sample-data"
    >
      <span>Sample Data</span>
      <span class="formula-canvas__sample-chevron" aria-hidden="true"></span>
    </button>

    <aside
      class="formula-sample-sheet"
      id="formula-sample-data"
      data-sample-data-sheet
      data-open="true"
      aria-hidden="false"
      aria-label="Sample data"
    >
      <div class="formula-sample-sheet__table-wrap">
        <table class="formula-sheet formula-sheet--reference">
          <caption class="sr-only">Sample spreadsheet</caption>
          <thead>
            <tr><th aria-hidden="true"></th>{['A', 'B', 'C', 'D'].map((column) => <th scope="col">{column}</th>)}</tr>
          </thead>
          <tbody>
            {rows.map((row, rowIndex) => (
              <tr>
                <th scope="row">{rowIndex + 1}</th>
                {row.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </aside>

    <div class="formula-entry">
      <span class="formula-entry__reference" aria-hidden="true">Total units sold in East</span>
      <div
        class="formula-entry__input"
        data-input-cell
        data-selected="true"
        tabindex="0"
        role="group"
        aria-label="Formula answer for total units sold in East, selected"
      >
        <span class="formula-entry__placeholder" data-placeholder>Drop formula here</span>
        <span class="formula-entry__formula" data-formula-output aria-live="polite">
          <button
            class="formula-token formula-token--marker chalk-piece--syntax"
            type="button"
            data-formula-marker
            aria-label="Required formula equals sign. Formulas always begin with equals and this marker cannot be removed."
            aria-describedby="formula-required-marker-help"
          >
            =
            <span class="formula-token__marker-tooltip" id="formula-required-marker-help" role="tooltip">
              Formulas always begin with =. This first sign stays in place.
            </span>
          </button>
        </span>
      </div>
    </div>

    <footer class="formula-daily__actions">
      <button class="formula-daily__clear" type="button" data-clear>Clear</button>
      <p data-status role="status" aria-live="polite"></p>
      <div class="formula-daily__primary-actions">
        <span class="formula-daily__help-anchor">
          <button
            class="formula-daily__help"
            type="button"
            data-help-button
            aria-expanded="false"
            aria-controls="formula-function-help"
          >
            Help
          </button>
        </span>
        <div
          class="formula-daily__help-panel"
          id="formula-function-help"
          data-help-panel
          role="group"
          aria-label="Formula function help"
          hidden
        >
          <div class="formula-daily__help-heading">
            <span class="formula-daily__help-title">Function help</span>
            <span class="formula-daily__help-meta">
              <span data-help-cost></span>
              <button
                class="formula-daily__help-pin"
                type="button"
                data-help-pin
                aria-pressed="false"
                aria-label="Pin function help"
                title="Pin function help"
              >
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M6 2.25h4l-.55 2.7 2.05 2.05v1.1H8.7v4.45L8 13.7l-.7-1.15V8.1H4.5V7l2.05-2.05L6 2.25Z" />
                </svg>
              </button>
            </span>
          </div>
          <div class="formula-daily__help-functions" data-help-functions></div>
          <div class="formula-daily__help-detail" data-help-detail aria-live="polite"></div>
          <div class="formula-daily__help-footer">
            <button class="formula-daily__help-reset" type="button" data-help-reset aria-label="Reset this question to its initial state" hidden>Reset</button>
          </div>
        </div>
        <button class="formula-daily__test" type="button" data-test-answer>Test Answer</button>
        <button class="formula-daily__submit" type="button" data-submit>Submit</button>
      </div>
    </footer>

    <div class="formula-cluster" data-cluster>
      <svg class="formula-cluster__strings" data-strings aria-hidden="true"></svg>
      <div class="formula-cluster__field" data-cluster-field aria-label="Formula pieces. Click a piece or drag it into the answer field.">
        {pieces.map((piece, index) => (
          <button
            class={`chalk-piece chalk-piece--${piece.kind}`}
            type="button"
            data-piece-id={piece.id}
            data-piece-value={piece.value}
            data-piece-kind={piece.kind}
            style={`--piece-index:${index}`}
            aria-label={`Add ${piece.value}`}
          >
            {piece.kind === 'function' ? (
              <>
                <span class="piece-part piece-part--function">{piece.value.slice(0, -1)}</span>
                <span class="piece-part piece-part--syntax">(</span>
              </>
            ) : piece.value}
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import './formula-daily.ts';
</script>
