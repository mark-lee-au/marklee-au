---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Photography by Mark Lee in Adelaide, South Australia, including portrait, event, landscape and personal work." />
    <meta name="theme-color" content="#080908" />
    <link rel="canonical" href="https://marklee.au/photography/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Photography | Mark Lee</title>
  </head>
  <body>
    <SiteHeader />
    <main class="site-shell">
      <section class="page-hero photography-intro">
        <span class="kicker">PHOTOGRAPHY</span>
        <h1>PHOTOGRAPHS OF PEOPLE, PLACES AND EVENTS.</h1>
        <p class="page-copy">Portrait, event, landscape and personal photography from Adelaide and beyond. This section is now part of the portfolio and will be expanded with selected work.</p>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .photography-intro { min-height: 66vh; }

  @media (max-width: 620px) {
    .photography-intro h1 { font-size: clamp(2.55rem, 14vw, 5.1rem); }
  }
</style>
