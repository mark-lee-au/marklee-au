---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import '../styles/global.css';

const featuredProjects = (await getProjects()).filter((project) => project.data.featured);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Mark Lee's data portfolio: data stories, maps and experiments." />
    <meta name="theme-color" content="#080908" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Mark Lee · Data / Maps / Lab</title>
  </head>
  <body>
    <SiteHeader />
    <main class="site-shell">
      <section class="hero">
        <div class="hero-copy">
          <span class="kicker">DATA / MAPS / EXPERIMENTS</span>
          <h1>DATA, MAPPED. MEASURED. MOVING.</h1>
          <p>A growing collection of visual data stories about places, patterns, history and everyday life.</p>
          <div class="hero-meta">
            <span>ADELAIDE, AUSTRALIA</span>
            <span>MARKLEE.AU</span>
          </div>
        </div>
        <div class="data-field" aria-label="Abstract animated data field">
          <span class="data-node"></span><span class="data-node"></span><span class="data-node"></span>
          <span class="data-node"></span><span class="data-node"></span><span class="data-node"></span>
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <h2>Browse the collection.</h2>
          <p>Finished work lives in DATA and MAPS. Smaller ideas and work in progress begin in LAB.</p>
        </div>
        <div class="category-grid">
          <CategoryCard href="/data" eyebrow="01" title="DATA" text="Finished visual stories built around a question, dataset or pattern." glyph="▥" />
          <CategoryCard href="/maps" eyebrow="02" title="MAPS" text="Geography, movement, place, history and spatial data." glyph="⌖" />
          <CategoryCard href="/lab" eyebrow="03" title="LAB" text="Small experiments, prototypes and ideas still taking shape." glyph="◌" />
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <h2>First experiments.</h2>
          <p>These are planned experiments. Explore the ideas as each piece takes shape.</p>
        </div>
        <div class="project-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
