---
import { getProjects } from '../lib/projects';
import HomeGalleryPreviews from '../visualisations/home-gallery/HomeGalleryPreviews.astro';
import '../styles/global.css';
import '../visualisations/home-gallery/home-gallery.css';

const allProjects = await getProjects();
const gameProjects = allProjects.filter((project) => project.data.category === 'games');
const labProjects = allProjects.filter((project) => project.data.category === 'lab');
const homeProjectSlugs = ['south-australian-name-curve', 'formula-daily', 'ascend'];
const homeProjects = homeProjectSlugs
  .map((slug) => allProjects.find((project) => project.data.slug === slug))
  .filter((project): project is (typeof allProjects)[number] => Boolean(project));

const slides = [
  {
    id: 'home',
    label: 'Home',
    eyebrow: 'Portfolio / Adelaide',
    title: 'Mark Lee',
    summary: 'Data visualisation, maps, browser games and photography.',
    detail: 'A portfolio of analytical projects, visual experiments and interactive work built to explain patterns clearly.',
    href: '/',
    linkLabel: 'Current view',
    listWeight: 1.1,
    projects: homeProjects,
  },
  {
    id: 'data',
    label: 'Data',
    eyebrow: 'Analysis / visual stories',
    title: 'Data',
    summary: 'Finished visual stories built around a question, dataset and method.',
    detail: 'Projects move here after the analysis and visual story are ready to stand as finished portfolio work.',
    href: '/data/',
    linkLabel: 'Open Data',
    listWeight: 1.2,
    projects: [],
  },
  {
    id: 'maps',
    label: 'Maps',
    eyebrow: 'Place / movement / geography',
    title: 'Maps',
    summary: 'Spatial projects about places, movement, infrastructure and change.',
    detail: 'Map work treats geography as part of the analysis rather than a background layer.',
    href: '/maps/',
    linkLabel: 'Open Maps',
    listWeight: 0.9,
    projects: [],
  },
  {
    id: 'games',
    label: 'Games',
    eyebrow: 'Logic / interaction',
    title: 'Games',
    summary: 'Small browser games built from logic, systems and custom interaction.',
    detail: 'Playable prototypes sit beside finished work so the interaction design can be tested in public.',
    href: '/games/',
    linkLabel: 'Open Games',
    listWeight: 1.25,
    projects: gameProjects.slice(0, 3),
  },
  {
    id: 'lab',
    label: 'Lab',
    eyebrow: 'Experiments / work in progress',
    title: 'Lab',
    summary: 'Visual experiments and data projects while they are still taking shape.',
    detail: 'The Lab keeps early work visible without presenting every experiment as a finished case study.',
    href: '/lab/',
    linkLabel: 'Open Lab',
    listWeight: 1.3,
    projects: labProjects.slice(0, 4),
  },
  {
    id: 'photography',
    label: 'Photography',
    eyebrow: 'Portrait / event / personal',
    title: 'Photography',
    summary: 'Portrait, event, landscape and personal photography from Adelaide and beyond.',
    detail: 'A separate visual practice alongside the data and interactive work on this site.',
    href: '/photography/',
    linkLabel: 'Open Photography',
    listWeight: 1.15,
    projects: [],
  },
  {
    id: 'about',
    label: 'About',
    eyebrow: 'Profile / approach',
    title: 'About',
    summary: 'About Mark Lee, the work on this site and the way projects are built.',
    detail: 'The portfolio is designed as a growing record of analytical thinking, visual communication and hands-on prototyping.',
    href: '/about/',
    linkLabel: 'Open About',
    listWeight: 0.62,
    projects: [],
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Mark Lee Portfolio',
  url: 'https://marklee.au/',
  description: 'Mark Lee portfolio of data visualisation, maps, browser games, analytical projects and photography from Adelaide, Australia.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Mark Lee portfolio of data visualisation, maps, browser games, analytical projects and photography from Adelaide, Australia." />
    <meta name="theme-color" content="#080908" />
    <link rel="canonical" href="https://marklee.au/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Mark Lee | Data, Maps, Games and Photography</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class="home-page">
    <main class="portfolio-gallery" data-gallery data-mode="carousel" aria-label="Mark Lee portfolio sections">
      <header class="gallery-header">
        <a class="gallery-brand" href="/" aria-label="Mark Lee home">MARK LEE</a>
        <p class="gallery-location">BUILT IN ADELAIDE, AUSTRALIA</p>
      </header>

      <div class="gallery-edge-magnet gallery-edge-magnet--left" aria-hidden="true"></div>
      <div class="gallery-edge-magnet gallery-edge-magnet--right" aria-hidden="true"></div>

      <button class="view-toggle" type="button" data-view-toggle aria-pressed="false" aria-label="Show overview">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="4" y="4" width="6" height="6" rx="1" />
          <rect x="14" y="4" width="6" height="6" rx="1" />
          <rect x="4" y="14" width="6" height="6" rx="1" />
          <rect x="14" y="14" width="6" height="6" rx="1" />
        </svg>
      </button>

      <section class="gallery-stage" data-gallery-stage aria-live="polite">
        {slides.map((slide, index) => (
          <article
            class="gallery-card"
            data-gallery-card
            data-slide-id={slide.id}
            data-slide-label={slide.label}
            data-slide-index={index}
            data-list-weight={slide.listWeight}
            aria-label={`${slide.label} section`}
          >
            <a
              class="gallery-card__surface-link"
              href={slide.href}
              aria-label={`Open ${slide.label}`}
              data-list-card-link
              draggable="false"
            ></a>

            <div class="gallery-card__count" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</span>
            </div>

            <div class="gallery-card__body">
              <div class="gallery-card__copy">
                <p class="gallery-card__eyebrow">{slide.eyebrow}</p>
                {slide.id === 'home' ? (
                  <h1>{slide.title}</h1>
                ) : (
                  <h2>{slide.title}</h2>
                )}
                <p class="gallery-card__summary">{slide.summary}</p>
                <p class="gallery-card__detail">{slide.detail}</p>
              </div>

              <HomeGalleryPreviews sectionId={slide.id} projects={slide.projects} />
            </div>

          </article>
        ))}
      </section>

      <div class="gallery-guides" data-gallery-guides aria-label="Carousel guidance">
        <button class="gallery-guide gallery-guide--previous" type="button" data-gallery-guide="previous" aria-label="Show previous section">
          <svg viewBox="0 0 64 40" aria-hidden="true">
            <path d="M61 20H5M5 20l15-15M5 20l15 15" />
          </svg>
        </button>
        <button class="gallery-guide gallery-guide--next" type="button" data-gallery-guide="next" aria-label="Show next section">
          <svg viewBox="0 0 64 40" aria-hidden="true">
            <path d="M3 20h56M59 20 44 5M59 20 44 35" />
          </svg>
        </button>
      </div>

      <div class="gallery-controls" data-gallery-controls>
        <div class="gallery-rail" data-gallery-rail role="group" aria-label="Choose portfolio section">
          <span class="gallery-rail__line" aria-hidden="true"></span>
          <span class="gallery-rail__thumb" data-gallery-thumb aria-hidden="true"></span>
          {slides.map((slide, index) => (
            <button
              class="gallery-rail__tick"
              type="button"
              data-gallery-tick
              data-slide-index={index}
              style={`--tick-position: ${(index / (slides.length - 1)) * 100}%`}
              aria-label={`Show ${slide.label}`}
            >
              <span class="gallery-rail__mark" aria-hidden="true"></span>
              <span class="gallery-rail__label" aria-hidden="true">{slide.label}</span>
            </button>
          ))}
        </div>
      </div>

      <label class="auto-swipe-control" data-auto-swipe-control hidden>
        <span class="auto-swipe-control__label">Auto Swipe</span>
        <span class="auto-swipe-control__switch">
          <input type="checkbox" role="switch" data-auto-swipe-toggle aria-label="Enable automatic edge swiping" />
          <span class="auto-swipe-control__track" aria-hidden="true"></span>
        </span>
      </label>
    </main>

    <script>
      import '../visualisations/home-gallery/home-gallery';
    </script>
  </body>
</html>
